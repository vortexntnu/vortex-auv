<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>landmark_targets</name>
  <version>0.0.0</version>
  <description>Landmark target library for behavior tree nodes: target pose from a map landmark, freeze, dead reckoning, track loss and course geometry</description>
  <maintainer email="hinthu5@hotmail.no">Vortex NTNU</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>vortex_utils</depend>
  <depend>vortex_utils_ros</depend>
  <depend>vortex_msgs</depend>
  <depend>rclcpp</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
