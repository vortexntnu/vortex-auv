<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>landmark_slam</name>
  <version>0.0.0</version>
  <description>Landmark SLAM (iSAM2 + JCBB) with an optional prior map: the RoboSub landmark map and the map to odom correction</description>
  <maintainer email="Hinthu5@hotmail.no">hinthujan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vortex_msgs</depend>
  <depend>vortex_utils_ros</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>gtsam</depend>
  <depend>yaml-cpp</depend>
  <depend>spdlog</depend>
  <depend>fmt</depend>
  <exec_depend>auv_setup</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
